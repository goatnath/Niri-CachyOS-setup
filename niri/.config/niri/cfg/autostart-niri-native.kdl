// ── Niri-native autostart (generated by migrate-to-niri.sh) ─────────────────
// Add  include "./cfg/autostart-niri-native.kdl"  to your config.kdl
// if it's not already included.

// Polkit agent — lets apps request elevated privileges (mounts, sudo GUIs, etc.)
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

// Gnome keyring — secrets/passwords without KWallet
spawn-at-startup "gnome-keyring-daemon" "--start" "--components=secrets,ssh,pkcs11"

// Clipboard history daemon — required for Noctalia's clipboard launcher
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"

