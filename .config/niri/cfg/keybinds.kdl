binds {
    Mod+Space                           { spawn "dms" "ipc" "launcher" "toggle"; }// ─── Core Basics (Launchers & Closing) ───
    Mod+Return                          { spawn "alacritty"; }
    // CachyOS / Noctalia Default Launcher
    Mod+D                               { spawn "qs" "-c" "noctalia-shell" "ipc" "call" "launcher" "toggle"; }
    Mod+Q                               { close-window; }
    // ─── App Shortcuts ───
    Mod+Z                               { spawn "zen-browser"; }
    Mod+1                               { spawn "nautilus"; }
    Mod+M                               { spawn "youtube-music-desktop-app"; }
    Mod+K                               { spawn "kdeconnect-app"; }
    // ─── Layout Controls ───
    Mod+CTRL+F                          { expand-column-to-available-width; }
    Mod+C                               { center-column; }
    Mod+CTRL+C                          { center-visible-columns; }
    Mod+Minus                           { set-column-width "-10%"; }
    Mod+Equal                           { set-column-width "+10%"; }
    Mod+Shift+Minus                     { set-window-height "-10%"; }
    Mod+Shift+Equal                     { set-window-height "+10%"; }
    // ─── Windows-Style Movement & Focus ───
    Mod+Left                            { focus-column-left; }
    Mod+Right                           { focus-column-right; }
    Mod+Up                              { focus-window-up; }
    Mod+Down                            { focus-window-down; }
    Mod+Shift+Left                      { move-column-left; }
    Mod+Shift+Right                     { move-column-right; }
    Mod+Shift+Up                        { move-window-up; }
    Mod+Shift+Down                      { move-window-down; }
    // ─── Modes ───
    Mod+T                               { toggle-window-floating; }
    Mod+F                               { fullscreen-window; }
    Mod+W                               { toggle-column-tabbed-display; }
    // ─── Screenshots (With DankMaterialShell dms screenshot & Dell Latitude PrtScr Key) ───
    Print                               { spawn "dms" "screenshot"; }
    Mod+Print                           { spawn "dms" "screenshot" "full"; }
    Mod+Shift+Print                     { spawn "dms" "screenshot" "last"; }
    // ─── Screen Recording (wf-recorder) ───
    Mod+Shift+R                         { spawn "bash" "-c" "pkill wf-recorder || wf-recorder -g \"$(slurp)\" -f ~/Videos/recording-$(date +%Y%m%d-%H%M%S).mp4"; }
    // ─── Lock Screen ───
    Mod+L                               { spawn "loginctl" "lock-session"; }
    // ─── Dell Latitude Hardware Keys (Fn Row) ───
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn "playerctl" "stop"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "sh" "-c" "dms brightness set backlight:intel_backlight $(( $(dms brightness get backlight:intel_backlight | awk '{print $2}' | tr -d '%') + 5 ))%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "sh" "-c" "dms brightness set backlight:intel_backlight $(( $(dms brightness get backlight:intel_backlight | awk '{print $2}' | tr -d '%') - 5 ))%"; }
    XF86KbdBrightnessUp  allow-when-locked=true { spawn "sh" "-c" "current=$(dms brightness get leds:dell::kbd_backlight | awk '{print $3}' | tr -d '()' | cut -d'/' -f1); if [ \"$current\" = \"0\" ]; then dms brightness set leds:dell::kbd_backlight 75%; elif [ \"$current\" = \"1\" ]; then dms brightness set leds:dell::kbd_backlight 100%; else dms brightness set leds:dell::kbd_backlight 0%; fi"; }
    XF86KbdLightOnOff    allow-when-locked=true { spawn "sh" "-c" "current=$(dms brightness get leds:dell::kbd_backlight | awk '{print $3}' | tr -d '()' | cut -d'/' -f1); if [ \"$current\" = \"0\" ]; then dms brightness set leds:dell::kbd_backlight 75%; elif [ \"$current\" = \"1\" ]; then dms brightness set leds:dell::kbd_backlight 100%; else dms brightness set leds:dell::kbd_backlight 0%; fi"; }
    XF86Display           { power-off-monitors; }
    XF86Search           allow-when-locked=true { spawn "dms" "ipc" "launcher" "toggle"; }
    XF86Sleep            allow-when-locked=true { spawn "systemctl" "suspend"; }
    XF86Suspend          allow-when-locked=true { spawn "systemctl" "suspend"; }
    XF86WLAN             allow-when-locked=true { spawn "nmcli" "radio" "wifi" "toggle"; }
    XF86RFKill           allow-when-locked=true { spawn "nmcli" "radio" "wifi" "toggle"; }
    // ─── Emergency Escape Key ───
    Mod+ESCAPE allow-inhibiting=false   { toggle-keyboard-shortcuts-inhibit; }
    // ─── Exit / Power ───
    CTRL+ALT+Delete                     { quit; }
    Mod+Shift+P                         { power-off-monitors; }
    Mod+O repeat=false                  { toggle-overview; }
}
